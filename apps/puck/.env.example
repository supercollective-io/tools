# Environment variables are explicit; the server does not auto-load this file.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=data/puck.sqlite
PUCK_ROOM_CAPACITY=140
PUCK_HTTP_MUTATION_LIMIT=240
# Optional instance operator access for the operator page and API clients.
# PUCK_OPERATOR_TOKEN=<private random token of at least 32 characters>
