HUB_PUBLIC_ORIGIN=https://we.supercollective.io
HUB_ALLOWED_ORIGINS=https://polymind.supercollective.io
HUB_OPERATOR_USER=organiser
HUB_OPERATOR_PASSWORD=replace-with-a-private-random-password
HUB_DATA_DIR=./data
HOST=127.0.0.1
PORT=3000

# Optional: override app-control destinations for another deployment.
# HUB_POLYMIND_ORIGIN=https://polymind.supercollective.io
# HUB_PUCK_ORIGIN=https://puck.supercollective.io
# Optional API preparation: copy each app's existing operator token here.
# HUB_POLYMIND_TOKEN=<same private value as Polymind OPERATOR_TOKEN>
# HUB_PUCK_TOKEN=<same private value as Puck PUCK_OPERATOR_TOKEN>
# Enable both participant websites in HUB_ALLOWED_ORIGINS when using both apps.

# Flight operator API: match FLIGHT_OPERATOR_TOKEN in the Flight service. Runtime secret.
# Leave unset to use manual invitations. Enable its origin in HUB_ALLOWED_ORIGINS.
# HUB_FLIGHT_TOKEN=
# HUB_FLIGHT_ORIGIN=https://fly.supercollective.io
