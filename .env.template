# Polymind: Coolify production import template (repository root build context).
# Select this file in Smart Scan > Review > Env file, then confirm Import.
# Enable Coolify default variables and interpolation. Set ALL entries runtime-only.
PUBLIC_ORIGIN=$COOLIFY_URL
HOST=0.0.0.0
PORT=3000
DATA_DIR=/data/polymind
HUB_URL=https://we.supercollective.io
# REQUIRED: supply a private random token of at least 32 characters before deploying.
# Generate once with: openssl rand -hex 32. Keep the existing token on redeployment.
OPERATOR_TOKEN=
# Optional provider keys and TRANSCRIPTION_MODEL are deliberately omitted.
