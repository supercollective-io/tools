# Hub: Coolify production import template (repository root build context).
# Select this file in Smart Scan > Review > Env file, then confirm Import.
# Enable Coolify default variables and interpolation. Set ALL entries runtime-only.
# HUB_PUBLIC_ORIGIN is derived from COOLIFY_URL at container startup.
# Set an explicit single origin only to override automatic selection.
HUB_ALLOWED_ORIGINS=https://polymind.supercollective.io
HUB_OPERATOR_USER=organiser
# REQUIRED: private random password of at least 24 characters. Preserve on redeployment.
HUB_OPERATOR_PASSWORD=
HUB_DATA_DIR=/data
HOST=0.0.0.0
PORT=3000

# Flight operator API: match FLIGHT_OPERATOR_TOKEN in the Flight service. Runtime secret.
# Leave unset to use manual invitations. Enable its origin in HUB_ALLOWED_ORIGINS.
# HUB_FLIGHT_TOKEN=
# HUB_FLIGHT_ORIGIN=https://fly.supercollective.io
