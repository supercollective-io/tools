{
  "name": "collective-microphone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node src/start.ts",
    "replay": "node src/start.ts replay",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "inspect": "node src/cli.ts inspect",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/web', 'dist/web', { recursive: true })\"",
    "verify": "pnpm run check && pnpm run typecheck && pnpm test && pnpm run build",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.0",
    "js-tiktoken": "1.0.21",
    "openai": "7.47.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
