{
  "name": "puck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13 <27",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "check": "biome check .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "backup": "tsx scripts/backup.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.server.json",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@sveltejs/kit": "3.1.1",
    "svelte": "5.57.3",
    "better-sqlite3": "12.11.1",
    "tsx": "4.23.15",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.0.0",
    "@types/ws": "8.18.2",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "@biomejs/biome": "2.6.6",
    "lefthook": "2.2.2"
  },
  "packageManager": "pnpm@12.18.0"
}
