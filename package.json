{
  "name": "supercollective-tools",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "check": "pnpm --recursive run check",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive --workspace-concurrency=1 run test --maxWorkers=4",
    "build": "pnpm --recursive run build",
    "verify": "just verify"
  }
}
